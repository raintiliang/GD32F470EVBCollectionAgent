    IMP_PIXFMT_ARGB1555 = 0,
    IMP_PIXFMT_ARGB4444,
    IMP_PIXFMT_ARGB8888,
    IMP_PIXFMT_RGB565,
    IMP_PIXFMT_RGB888,
    IMP_PIXFMT_BGR888,
} IMPPixelFormat;

